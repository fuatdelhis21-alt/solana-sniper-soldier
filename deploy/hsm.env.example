# Remote HSM signer configuration (/etc/solana-hft/hsm.env, 0600 solana-hsm).
# base64 of the 64-byte wallet keypair (secret+public). Example to convert a
# solana-keygen JSON file:
#   python3 -c "import json,base64,sys;print(base64.b64encode(bytes(json.load(open(sys.argv[1])))).decode())" wallet.json
HSM_KEY_B64=
# The server refuses to start without a valid HSM_KEY_B64 (no ephemeral
# fallback). HSM_REQUIRE_KEY is no longer needed (kept harmless).
HSM_REQUIRE_KEY=1

# Signing policy: only the bot's swap / wrap / tip transactions are signed,
# with every fund movement staying in the wallet's own accounts.
# Max lamports one transaction may send out of the wallet (wSOL wrap + tip):
HSM_MAX_TRANSFER_LAMPORTS=60000000
# Max compute-unit price (micro-lamports per CU):
HSM_MAX_CU_PRICE_MICRO_LAMPORTS=5000000
# Extra allowed transfer destinations (comma-separated), e.g. for send_transfer:
HSM_EXTRA_TRANSFER_DESTINATIONS=
