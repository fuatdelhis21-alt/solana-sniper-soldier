[Unit]
Description=Solana HFT remote HSM signer (mTLS, 127.0.0.1:8443)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=solana-hsm
Group=solana-hsm
# HSM_KEY_B64=<base64 64-byte key>, HSM_REQUIRE_KEY=1 (never an ephemeral key)
EnvironmentFile=/etc/solana-hft/hsm.env
Environment=HSM_REQUIRE_KEY=1
StateDirectory=solana-hsm
ExecStart=/opt/solana-hft/bin/hsm_server --certs /etc/solana-hft/hsm-certs --log-file /var/lib/solana-hsm/hsm_audit.log
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/solana-hsm
ReadOnlyPaths=/etc/solana-hft

[Install]
WantedBy=multi-user.target
