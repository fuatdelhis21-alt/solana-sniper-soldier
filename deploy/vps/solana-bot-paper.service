[Unit]
Description=Solana HFT paper trader (real market data, no transaction submission)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot_service
Group=bot_service
WorkingDirectory=/opt/solana-bot
EnvironmentFile=/etc/solana-bot.env
ExecStart=/opt/solana-bot/run_paper.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/solana-bot/data-paper /opt/solana-bot/logs

[Install]
WantedBy=multi-user.target