# Solana HFT Platform — Environment template (VPS / systemd)
#
# Copy to /etc/solana-hft/bot.env (0600, owned by the bot user) on the VPS.
# This file is loaded by the systemd unit via EnvironmentFile. It must NEVER
# contain a real secret committed to git — this is a TEMPLATE with safe
# placeholders only.
#
# NOTE: The bot reads configuration from CLI flags (see `solana-sniper --help`)
# plus the environment variables listed below. It does NOT read a TOML config
# file. The systemd unit passes the CLI flags; this file supplies env vars.
#
# ============================================================================
# OPERATING MODE (BÖLÜM 4)
# ============================================================================
# The systemd unit defaults to PAPER mode (no on-chain transactions, no HSM).
# To switch to dry-run, edit the unit's ExecStart (--paper -> --dry-run).
# LIVE mode is NEVER the default: it requires --live --confirm-live plus the
# HSM mTLS flags, and an explicit operator `systemctl restart`. The bot
# refuses to start live without --confirm-live (fail-closed).

# ============================================================================
# RPC / WS — DEVNET/TEST ONLY BY DEFAULT. NEVER mainnet unless an operator
# explicitly overrides this AND the unit ExecStart, with full manual approval.
# ============================================================================
# These are passed as CLI flags in the systemd unit, not read from this file.
# They are listed here only as documentation of the safe default.
#   --rpc  https://api.devnet.solana.com
#   --ws   wss://api.devnet.solana.com
#   --ws-endpoint wss://api.devnet.solana.com (optional real-time feed)

# ============================================================================
# LOGGING (BÖLÜM 2D)
# ============================================================================
# RUST_LOG controls the tracing filter. JSON structured logging + daily file
# rotation is always on (see init_tracing). Never log secrets.
RUST_LOG=info,solana_sniper=debug
RUST_BACKTRACE=0

# ============================================================================
# RISK LIMITS (BÖLÜM 4) — env-overridable, validated (never silently unset).
# All values are read by RiskConfig::production_defaults() in risk.rs.
# Zero/invalid values are REJECTED at startup (fail-closed).
# ============================================================================
# Price staleness limit in ms (default 5000).
PRICE_STALENESS_MS=5000
# Circuit-breaker half-open cooldown in ms (default 300000 = 5 min).
BREAKER_COOLDOWN_MS=300000
# Max exit retry attempts before EXIT_BLOCKED (default 3).
EXIT_MAX_ATTEMPTS=3
# Exit retry backoff in ms (default 5000).
EXIT_BACKOFF_MS=5000
# Daily loss limit in lamports (default 200000000 = 0.2 SOL).
DAILY_LOSS_LIMIT_LAMPORTS=200000000

# ============================================================================
# HSM / mTLS (BÖLÜM 7) — paths only, NO secrets here.
# The bot reaches the HSM over loopback mTLS. The client identity + CA are
# files OUTSIDE the source tree, readable by the bot user. The HSM private
# key lives ONLY on the HSM service (solana-hsm user), never here.
# ============================================================================
# These are passed as CLI flags in the systemd unit (live mode only):
#   --hsm-endpoint https://127.0.0.1:8443
#   --hsm-ca /etc/solana-hft/hsm/ca.pem
#   --hsm-client-identity /etc/solana-hft/hsm/client_all.pem

# ============================================================================
# METRICS (BÖLÜM 2C) — default localhost only. Never expose to the internet.
# ============================================================================
# Passed as --metrics-addr 127.0.0.1:9898 in the systemd unit. A Prometheus
# scraper on the VPS reads http://127.0.0.1:9898/metrics. Do NOT bind 0.0.0.0
# unless you have an explicit, justified reason and a firewall rule.

# ============================================================================
# SECRETS — NEVER put real values in this template or commit them.
# Real secrets are injected at deploy time via files with 0600 perms:
#   - HSM_KEY_B64  → /etc/solana-hft-hsm/hsm.env (owned by solana-hsm)
#   - mTLS client identity → /etc/solana-hft/hsm/client_all.pem
#   - RPC auth token (if any) → /etc/solana-hft/bot.env
# ============================================================================
