# Solana HFT Platform — Configuration
# Copy to .env and fill in your values

# RPC & WebSocket Endpoints
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Jito Block Engine
JITO_TPU_URL=frankfurt.mainnet.block-engine.jito.wtf
JITO_AUTH_TOKEN=

# Wallet
WALLET_PATH=./wallet.json

# Data Directory
DATA_DIR=./data

# Risk Limits
MAX_SLIPPAGE_BPS=50
MAX_TRADE_SIZE_SOL=0.01
DAILY_LOSS_LIMIT_SOL=0.1

# Priority Fee (microLamports)
PRIORITY_FEE_MICRO_LAMPORTS=10000
COMPUTE_UNITS=400000

# Logging
LOG_DIR=./logs
LOG_LEVEL=info,solana_sniper=debug
