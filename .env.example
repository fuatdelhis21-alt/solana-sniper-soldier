# Solana HFT Platform — bot configuration template
#
# Every solana-sniper CLI flag can be set here via its SNIPER_* variable.
# Local runs: copy to ./.env (loaded automatically from the working dir).
# Server: /etc/solana-hft/solana-hft.env (systemd EnvironmentFile, 0600).
# An explicit CLI flag always overrides the environment.
# This template contains no real secrets. Live trading is disabled by default
# and requires explicit confirmation plus the configured remote HSM.

# ── Mode (choose ONE; leave all false for the offline simulation) ──
SNIPER_PAPER=false
SNIPER_DRY_RUN=false
SNIPER_LIVE=false
# Manual arm switch: LIVE refuses to start without it.
SNIPER_CONFIRM_LIVE=false
# 0 = run until stopped (systemd); N = stop after N iterations.
SNIPER_ITERATIONS=0
# Pause between iterations (ms). Each iteration makes several RPC calls:
# public/free RPC needs ~3000+, a paid plan can go down to 200.
SNIPER_LOOP_INTERVAL_MS=3000

# ── Cluster (devnet defaults; explicitly configure mainnet when approved) ──
SNIPER_RPC=https://api.devnet.solana.com
SNIPER_WS=wss://api.devnet.solana.com
# Optional real-time programSubscribe feed (falls back to RPC polling).
#SNIPER_WS_ENDPOINT=wss://api.devnet.solana.com

# ── Market (required for paper / live) ──
# Raydium CLMM pool + direction. Input = what you pay with (wSOL below).
SNIPER_POOL_ID=
SNIPER_INPUT_MINT=So11111111111111111111111111111111111111112
SNIPER_OUTPUT_MINT=
# Real on-chain liquidity + holder concentration (required for live).
SNIPER_LIVE_RISK_DATA=true
#SNIPER_BLOCKLIST_FILE=/etc/solana-hft/blocklist.txt
SNIPER_MAX_TOP_HOLDER_PCT=50

# ── Remote HSM signer (required for live; mTLS mandatory) ──
SNIPER_HSM_ENDPOINT=https://127.0.0.1:8443
SNIPER_HSM_CA=/etc/solana-hft/client-certs/ca.pem
SNIPER_HSM_CLIENT_IDENTITY=/etc/solana-hft/client-certs/client_all.pem
# Wallet pubkey the HSM must sign with (required for live).
SNIPER_EXPECTED_SIGNER=

# ── Execution ──
SNIPER_MAX_SLIPPAGE_BPS=100
# Entry economics (exact quote from an on-chain simulation of the swap):
# max price impact vs spot, and min expected net edge after both legs'
# trading fee + impact + network fees (bps of the position).
SNIPER_MAX_PRICE_IMPACT_BPS=300
SNIPER_MIN_NET_EDGE_BPS=300
# The exit cannot be simulated before the tokens are held: its impact is
# estimated as this % of the measured entry impact (min 100), plus a reserve
# of failed transactions. Position must be <= this many bps of the pool's
# SOL-side liquidity (unknown liquidity = no trade).
SNIPER_EXIT_IMPACT_PCT=200
SNIPER_FAILED_TX_RESERVE=1
SNIPER_MAX_POSITION_LIQUIDITY_BPS=200
# Widen exit slippage after failed exits (up to 5%). Off by default.
SNIPER_EXIT_SLIPPAGE_ESCALATION=false
# Trailing stop (opt-in, 0 = off): exit when the price falls this many bps
# below its best level since entry, once the position was >= the activation
# profit. Same rule in paper and live — measure it in paper first
# (sniper_report.py prints each trade's best/worst move).
SNIPER_TRAILING_STOP_BPS=0
SNIPER_TRAILING_ACTIVATION_BPS=500
# Signal gate: EMA/MACD trend + RSI/volatility/liquidity vetoes over this
# process's own pool-price samples; entries wait for the warm-up (~34 samples).
SNIPER_SIGNAL_GATE=true
SNIPER_SIGNAL_MIN_CONFIDENCE=70
SNIPER_SIGNAL_SAMPLE_MS=2000
# Newest sample older than this (ms) = stale_data, no trade.
SNIPER_SIGNAL_MAX_AGE_MS=30000
SNIPER_MAX_SPEND_SOL=0.01
SNIPER_PRIORITY_FEE_MICRO_LAMPORTS=10000
SNIPER_COMPUTE_UNIT_LIMIT=300000
# Sell an open position after this many seconds regardless of price (0 = off).
SNIPER_MAX_HOLD_SECS=86400
# Jito (optional): bundles with RPC fallback.
#SNIPER_JITO_ENDPOINT=https://frankfurt.mainnet.block-engine.jito.wtf
#SNIPER_JITO_TIP_LAMPORTS=10000   # required with Jito (>= 1000); tip accounts are read live from the Block Engine

# Minimum SOL-side pool liquidity for an entry (SOL, floor 20).
SNIPER_MIN_LIQUIDITY_SOL=1000

# ── New-pool sniper (pool-sniper / solana-hft-sniper.service) ──
# pool-sniper watches Raydium CLMM CreatePool events and starts one
# solana-sniper --single-trade process per qualifying wSOL pool. It sets
# the mode, pool, mints and iterations of that process itself, so the
# SNIPER_PAPER/DRY_RUN/LIVE/POOL_ID/... values above do not apply to it.
# paper | dry-run | live  (live also needs SNIPER_DISCOVERY_CONFIRM_LIVE=true
# plus the HSM + SNIPER_EXPECTED_SIGNER settings above)
SNIPER_DISCOVERY_MODE=paper
SNIPER_DISCOVERY_CONFIRM_LIVE=false
# A new pool stays on the watch list this long, checked every RECHECK_SECS.
SNIPER_DISCOVERY_WATCH_SECS=1800
SNIPER_DISCOVERY_RECHECK_SECS=30
SNIPER_DISCOVERY_MAX_WATCH=50
# Per pool: wait this long for an entry signal, sell after MAX_HOLD_SECS.
SNIPER_DISCOVERY_ENTRY_WINDOW_SECS=300
SNIPER_DISCOVERY_MAX_HOLD_SECS=3600
SNIPER_DISCOVERY_MAX_POOLS_PER_DAY=20
# Pre-filter liquidity for handing a pool to a trading process (SOL);
# unset = SNIPER_MIN_LIQUIDITY_SOL (the entry threshold).
#SNIPER_DISCOVERY_MIN_LIQUIDITY_SOL=50
# Supervisor health: /health = 503 when its loop stalls or the CLMM log
# stream is silent for 3 min; /metrics = watch list / started pools ("" = off).
SNIPER_DISCOVERY_HEALTH_ADDR=127.0.0.1:9091

# ── Observability / state ──
SNIPER_METRICS_ADDR=127.0.0.1:9090
SNIPER_DATA_DIR=./data
# Price staleness limit for the risk gate (ms).
PRICE_STALENESS_MS=5000
RUST_LOG=info,solana_sniper=debug

# Hard risk limits are NOT configurable here (fail-closed, in code):
# 0.05 SOL/trade, 5 trades/day, 0.20 SOL daily loss kill switch,
# 1 open position, 2% max slippage. See solana-sniper/src/risk.rs.
