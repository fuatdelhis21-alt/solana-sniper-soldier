# Solana HFT Platform — bot configuration
#
# Every solana-sniper CLI flag can be set here via its SNIPER_* variable.
# Local runs: copy to ./.env (loaded automatically from the working dir).
# Server: /etc/solana-hft/solana-hft.env (systemd EnvironmentFile, 0600).
# An explicit CLI flag always overrides the environment.

# ── Mode (choose ONE; leave all false for the offline simulation) ──
SNIPER_PAPER=false
SNIPER_DRY_RUN=false
SNIPER_LIVE=false
# Manual arm switch: LIVE refuses to start without it.
SNIPER_CONFIRM_LIVE=false
# 0 = run until stopped (systemd); N = stop after N iterations.
SNIPER_ITERATIONS=0
# Pause between iterations (ms). Each iteration makes several RPC calls:
# public/free RPC needs ~3000+, a paid plan can go down to 200.
SNIPER_LOOP_INTERVAL_MS=3000

# ── Cluster (paid mainnet RPC recommended: Helius / Triton / QuickNode) ──
SNIPER_RPC=https://api.mainnet-beta.solana.com
SNIPER_WS=wss://api.mainnet-beta.solana.com
# Optional real-time programSubscribe feed (falls back to RPC polling).
#SNIPER_WS_ENDPOINT=wss://api.mainnet-beta.solana.com

# ── Market (required for paper / live) ──
# Raydium CLMM pool + direction. Input = what you pay with (wSOL below).
SNIPER_POOL_ID=
SNIPER_INPUT_MINT=So11111111111111111111111111111111111111112
SNIPER_OUTPUT_MINT=
# Real on-chain liquidity + holder concentration (required for live).
SNIPER_LIVE_RISK_DATA=true
#SNIPER_BLOCKLIST_FILE=/etc/solana-hft/blocklist.txt
SNIPER_MAX_TOP_HOLDER_PCT=50

# ── Remote HSM signer (required for live; mTLS mandatory) ──
SNIPER_HSM_ENDPOINT=https://127.0.0.1:8443
SNIPER_HSM_CA=/etc/solana-hft/client-certs/ca.pem
SNIPER_HSM_CLIENT_IDENTITY=/etc/solana-hft/client-certs/client_all.pem
# Wallet pubkey the HSM must sign with (required for live).
SNIPER_EXPECTED_SIGNER=

# ── Execution ──
SNIPER_MAX_SLIPPAGE_BPS=100
SNIPER_MAX_SPEND_SOL=0.01
SNIPER_PRIORITY_FEE_MICRO_LAMPORTS=10000
SNIPER_COMPUTE_UNIT_LIMIT=300000
# Sell an open position after this many seconds regardless of price (0 = off).
SNIPER_MAX_HOLD_SECS=86400
# Jito (optional): bundles with RPC fallback.
#SNIPER_JITO_ENDPOINT=https://frankfurt.mainnet.block-engine.jito.wtf
#SNIPER_JITO_TIP_LAMPORTS=10000   # required with Jito (>= 1000); tip accounts are read live from the Block Engine

# ── Observability / state ──
SNIPER_METRICS_ADDR=127.0.0.1:9090
SNIPER_DATA_DIR=./data
# Price staleness limit for the risk gate (ms).
PRICE_STALENESS_MS=5000
RUST_LOG=info,solana_sniper=debug

# Hard risk limits are NOT configurable here (fail-closed, in code):
# 0.05 SOL/trade, 5 trades/day, 0.20 SOL daily loss kill switch,
# 1 open position, 2% max slippage. See solana-sniper/src/risk.rs.
